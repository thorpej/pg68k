GAL22V10
CTLSPDEC

 FC0 FC1 FC2  A1      A2      A3      A4      A5    A6   A7 /UDS   GND
/LDS RnW NC  /DDUSEL /DDLSEL /CSUSEL /CSLSEL /ERRD /ERWR NC  DTACK VCC

;
; Board control space is selected when:
;
;     FC2 * /FC1 * /FC0 * /A3 * /A2 * /A1
;     |_______________|   |_____________|
;           FC==4                0
;
; A7 A6 A5 A4
;  0  0  0  0 - 0 - Diagnostic display register(s)
;  0  0  0  1 - 1 - Configuration switches
;  0  0  1  0 - 2 - System enable register
;

;
; Generate the /DTACK output.
;
; We drive an open-drain inverter.  This also serves as a proxy for
; "board control space is selected".
;
DTACK = FC2 * /FC1 * /FC0 * /A3 * /A2 * /A1 * UDS
      + FC2 * /FC1 * /FC0 * /A3 * /A2 * /A1 * LDS;

;
; Diagnostic display register selection (write only).
;
DDUSEL = DTACK * /A7 * /A6 * /A5 * /A4 * UDS * /RnW;
DDLSEL = DTACK * /A7 * /A6 * /A5 * /A4 * LDS * /RnW;

;
; Configuration switches (read only).
;
CSUSEL = DTACK * /A7 * /A6 * /A5 *  A4 * UDS *  RnW;
CSLSEL = DTACK * /A7 * /A6 * /A5 *  A4 * LDS *  RnW;

;
; System enable register selection (read/write).
;
ERRD = DTACK * /A7 * /A6 *  A5 * /A4 * UDS *  RnW;
ERWR = DTACK * /A7 * /A6 *  A5 * /A4 * UDS * /RnW;

DESCRIPTION

Board control space decode logic for the cpu010.
